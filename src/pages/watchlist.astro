---
import Base from '../layouts/Base.astro';
import MyCourses from '../components/MyCourses';
import { getPublishedCourses, flattenLessons } from '../lib/courses';
const courses = (await getPublishedCourses()).map((c) => ({
  id: c.id, title: c.data.title, summary: c.data.summary, lang: c.data.language, teacher: c.data.source.name,
  lessons: flattenLessons(c).map((l) => ({ slug: l.slug, title: l.title }))
}));
---
<Base title="My courses" description="Courses you saved and your progress, stored on this device." noindex>
  <h1>My courses</h1>
  <MyCourses client:load courses={courses} />
</Base>
