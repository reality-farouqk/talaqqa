---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="prose">
    <h1>Page not found</h1>
    <p class="lede">This page doesn't exist or was moved. If a course was here, it may have been removed at the creator's request.</p>
    <p class="actions"><a class="btn" href="/courses/">Browse courses</a><a class="btn ghost" href="/report/">Report a broken link</a></p>
  </div>
</Base>
