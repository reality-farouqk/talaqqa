---
import Base from '../../../layouts/Base.astro';
import Thumb from '../../../components/Thumb.astro';
import Player from '../../../components/Player';
import CompleteButton from '../../../components/CompleteButton';
import LessonTools from '../../../components/LessonTools';
import LessonTracker from '../../../components/LessonTracker';
import LessonChecks from '../../../components/LessonChecks';
import { issueUrl } from '../../../config';
import { getPublishedCourses, getDraftCourses, flattenLessons, levelLabel, nextInPath, courseUrl, lessonUrl, youtubeWatchUrl, dirFor } from '../../../lib/courses';
import { getTrack, trackUrl } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const paths = [];
  const all = await getPublishedCourses();
  const drafts = (await getDraftCourses()).map((d) => d.course);
  for (const course of [...all, ...drafts]) {
    const lessons = flattenLessons(course);
    const nextCourse = course.data.status === 'draft' ? undefined : nextInPath(course, all);
    lessons.forEach((lesson, i) => paths.push({
      params: { course: course.id, lesson: lesson.slug },
      props: { course, lesson, index: i, total: lessons.length, prev: lessons[i - 1], next: lessons[i + 1], nextCourse }
    }));
  }
  return paths;
}
const { course, lesson, index, total, prev, next, nextCourse } = Astro.props;
const track = getTrack(course.data.track)!;
// Auto-next continues into the next course of the path after the last lesson.
const nextCourseFirst = nextCourse && flattenLessons(nextCourse)[0];
const upNext = next
  ? { url: lessonUrl(course.id, next.slug), title: next.title }
  : nextCourseFirst && { url: lessonUrl(nextCourse.id, nextCourseFirst.slug), title: `${nextCourse.data.title}: ${nextCourseFirst.title}` };
const d = course.data;
const key = `${course.id}/${lesson.slug}`;
const dir = dirFor(d.language);
const desc = lesson.summary ?? `Lesson ${index + 1} of ${total} in ${d.title}, taught by ${d.source.name}.`;
const thumb = lesson.youtube_id ? `https://i.ytimg.com/vi/${lesson.youtube_id}/hqdefault.jpg` : undefined;
// uploadDate and duration arrive with the YouTube metadata sync (Phase 2).
const isDraft = d.status === 'draft';
const jsonLd = lesson.youtube_id && !d.demo && !isDraft ? {
  '@context': 'https://schema.org', '@type': 'VideoObject',
  name: lesson.title, description: desc, thumbnailUrl: thumb, inLanguage: d.language,
  embedUrl: `https://www.youtube-nocookie.com/embed/${lesson.youtube_id}`,
  url: new URL(lessonUrl(course.id, lesson.slug), Astro.site).href,
  author: { '@type': 'Organization', name: d.source.name, ...(d.source.url ? { url: d.source.url } : {}) }
} : undefined;
const report = issueUrl('broken-video.yml', `Problem with lesson: ${key}`);
---
<Base section={trackUrl(track.id)} title={`${lesson.title} · ${d.title}`} description={desc} jsonLd={jsonLd} image={thumb} noindex={d.demo || isDraft} ogType="video.other"
  breadcrumbs={[{ name: track.label, href: trackUrl(track.id) }, { name: d.title, href: courseUrl(course.id) }, { name: lesson.title, href: lessonUrl(course.id, lesson.slug) }]}>
  <LessonTracker client:load course={course.id} lesson={lesson.slug} />
  <div class="watch">
    <div class="watch-player">
      <Player client:load youtubeId={lesson.youtube_id} title={lesson.title} start={lesson.start_seconds} end={lesson.end_seconds} lessonKey={key}
        nextUrl={upNext?.url} nextTitle={upNext?.title} />
    </div>
    <article class="watch-info">
      <div lang={d.language} dir={dir}>
        <h1 class="lesson-title">{lesson.title}</h1>
        <p class="meta">Lesson {index + 1} of {total} · {lesson.moduleTitle}{d.demo && <> · <span class="badge">Demo</span></>}</p>
      </div>
      <div class="action-row">
        <CompleteButton client:load lessonKey={key} />
        <LessonTools client:idle lessonKey={key} title={lesson.title} />
      </div>
      <div class="source">
        <span class="avatar" aria-hidden="true">{d.source.name.trim().charAt(0)}</span>
        <span class="source-name"><strong dir="auto">{d.source.url ? <a href={d.source.url} rel="noopener">{d.source.name}</a> : d.source.name}</strong>
          <span class="meta">{lesson.youtube_id && <><a href={youtubeWatchUrl(lesson.youtube_id, lesson.start_seconds)} rel="noopener">Watch on YouTube</a> · </>}<a href={report} rel="noopener">Report a problem</a></span></span>
      </div>
      {lesson.summary && <p class="prose" lang={d.language} dir={dir}>{lesson.summary}</p>}
      <nav class="pager" aria-label="Lesson navigation">
        {prev ? <a class="btn ghost" href={lessonUrl(course.id, prev.slug)} rel="prev"><span class="flip" aria-hidden="true">←</span> Previous</a> : <span />}
        {next ? <a class="btn" href={lessonUrl(course.id, next.slug)} rel="next">Next lesson <span class="flip" aria-hidden="true">→</span></a> : nextCourse
          ? <a class="btn" href={courseUrl(nextCourse.id)}>Next course: <span dir="auto">{nextCourse.data.title}</span></a>
          : <a class="btn" href={courseUrl(course.id)}>Back to course</a>}
      </nav>
    </article>
    <aside class="watch-list lessons" aria-labelledby="toc-h" lang={d.language} dir={dir}>
      <p class="eyebrow">Course content</p>
      <h2 id="toc-h" class="toc-title"><a href={courseUrl(course.id)}>{d.title}</a></h2>
      {d.modules.map((m) => (
        <>
          <h3 style="font-size:.95rem;margin:1rem 0 .25rem">{m.title}</h3>
          <ol class="lesson-list">
            {m.lessons.map((l) => <li><a href={lessonUrl(course.id, l.slug)} data-lesson-key={`${course.id}/${l.slug}`} aria-current={l.slug === lesson.slug ? 'page' : undefined}><Thumb id={l.youtube_id} /><span class="lt">{l.title}<span class="sr-status"></span></span></a></li>)}
          </ol>
        </>
      ))}
    </aside>
  </div>
  <LessonChecks client:idle />
</Base>
