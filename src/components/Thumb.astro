---
// Video thumbnail from YouTube's image server, or a plain tile when there is no video yet.
import { clock, videoMeta } from '../lib/videos';
interface Props { id?: string; label?: string; showDuration?: boolean; }
const { id, label = '', showDuration = true } = Astro.props;
const duration = showDuration ? clock(videoMeta(id)?.duration) : '';
---
{id
  ? <span class="thumb-wrap"><img class="thumb" src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" />{duration && <span class="dur">{duration}</span>}</span>
  : <span class="thumb thumb-empty" aria-hidden="true">{label}</span>}
