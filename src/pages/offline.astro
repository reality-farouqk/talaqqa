---
import Base from '../layouts/Base.astro';
---
<Base title="You're offline" description="This page isn't available offline." noindex>
  <div class="prose">
    <h1>You're offline</h1>
    <p class="lede">This page hasn't been saved on your device yet. Pages you've opened before still work without a connection.</p>
    <p class="actions"><a class="btn" href="/watchlist/">My courses</a><a class="btn ghost" href="/courses/">All courses</a></p>
    <p class="meta">Videos play from YouTube and always need a connection.</p>
  </div>
</Base>
