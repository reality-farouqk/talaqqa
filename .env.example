# Public URL of the site (sitemap, canonical URLs, Open Graph).
SITE_URL=https://example.org
# Set to "production" for release builds: fails if any demo course is published.
CONTENT_MODE=
# YouTube Data API v3 key, used only by the discovery engine (npm run discover). Never commit a real key.
YOUTUBE_API_KEY=
# Accounts (Phase 2). Set as Cloudflare Pages secrets in production; DATABASE_URL also as a GitHub secret for migrations.
# Neon pooled connection string.
DATABASE_URL=
# Long random string (e.g. `openssl rand -base64 32`). Signs session cookies.
BETTER_AUTH_SECRET=
# Optional: Google sign-in (Google Cloud OAuth client; redirect URI https://<site>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
