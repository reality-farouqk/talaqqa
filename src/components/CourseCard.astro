---
import { subjectLabel, levelLabel, flattenLessons, courseUrl, dirFor, languageName, type Course } from '../lib/courses';
const { course } = Astro.props as { course: Course };
const d = course.data;
const n = flattenLessons(course).length;
---
<a class="course-card" href={courseUrl(course.id)}>
  <span class="meta">{subjectLabel(course)} · {levelLabel(d.level)}{d.language !== 'en' && ` · ${languageName(d.language)}`} {d.demo && <span class="badge">Demo</span>}</span>
  <h3 lang={d.language} dir={dirFor(d.language)}>{d.title}</h3>
  <p lang={d.language} dir={dirFor(d.language)}>{d.summary}</p>
  <span class="meta"><bdi>{d.source.name}</bdi> · {n} {n === 1 ? 'lesson' : 'lessons'}</span>
</a>
