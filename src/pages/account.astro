---
import Base from '../layouts/Base.astro';
import Account from '../components/Account';
---
<Base title="Account" description="Sign in to keep your progress on every device." noindex>
  <h1>Account</h1>
  <div class="results"><Account client:load /></div>
</Base>
<style is:global>
  .account { display: grid; gap: .9rem; max-width: 26rem; }
  .account p { margin: 0; }
  .account-form { display: grid; gap: .75rem; }
  .account-form label { display: grid; gap: .3rem; font-weight: 500; }
  .account-form input { font: inherit; padding: .65rem .85rem; min-height: 48px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); color: var(--ink); }
  .account .error { color: var(--danger); }
  .account .or { text-align: center; }
  .account .link { background: none; border: 0; padding: 0; font: inherit; color: var(--teal); text-decoration: underline; cursor: pointer; min-height: 44px; }
  .account .danger summary { cursor: pointer; color: var(--danger); min-height: 44px; display: flex; align-items: center; }
  .account .danger p { margin-block: .25rem .75rem; }
</style>
