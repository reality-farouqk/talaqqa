---
import Base from '../../../layouts/Base.astro';
import CourseCard from '../../../components/CourseCard.astro';
import { getPublishedCourses, courseUrl, type Course } from '../../../lib/courses';
import { TRACKS, LEVELS, trackUrl, topicUrl, type Track, type Subject } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const courses = await getPublishedCourses();
  // Only subjects with at least one course get a page.
  return TRACKS.flatMap((track) => track.subjects
    .map((subject) => ({ track, subject, courses: courses.filter((c) => c.data.track === track.id && c.data.subject === subject.id) }))
    .filter((t) => t.courses.length)
    .map((t) => ({ params: { track: t.track.id, subject: t.subject.id }, props: t })));
}
const { track, subject, courses } = Astro.props as { track: Track; subject: Subject; courses: Course[] };
const teachers = [...new Set(courses.map((c) => c.data.source.name))];
const real = courses.filter((c) => !c.data.demo);
const jsonLd = real.length ? {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: subject.label,
  mainEntity: { '@type': 'ItemList', itemListElement: real.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(courseUrl(c.id), Astro.site).href })) }
} : undefined;
---
<Base section={trackUrl(track.id)} title={`${subject.label} courses`} jsonLd={jsonLd} noindex={!real.length}
  description={`Free ${subject.label} video courses from the basics to advanced, taught by ${teachers.slice(0, 3).join(', ')}.`}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: track.label, href: trackUrl(track.id) }, { name: subject.label, href: topicUrl(track.id, subject.id) }]}>
  <p class="ar" lang="ar" dir="rtl">{subject.arabic}</p>
  <h1 style="margin-block-start:.25rem">{subject.label}</h1>
  <p class="meta">{courses.length} {courses.length === 1 ? 'course' : 'courses'} · {teachers.length} {teachers.length === 1 ? 'teacher' : 'teachers'}</p>
  {LEVELS.map((l) => {
    const inLevel = courses.filter((c) => c.data.level === l.id);
    return inLevel.length > 0 && (
      <section aria-labelledby={`h-${l.id}`}>
        <h2 id={`h-${l.id}`}>{l.label}</h2>
        <ul class="grid">{inLevel.map((c) => <li><CourseCard course={c} /></li>)}</ul>
      </section>
    );
  })}
  <section class="note" aria-labelledby="t-h">
    <h2 id="t-h" class="eyebrow">Teachers</h2>
    <ul class="chips" style="margin:0">{teachers.map((t) => <li><a href={`/search/?teacher=${encodeURIComponent(t)}`}><bdi>{t}</bdi></a></li>)}</ul>
  </section>
</Base>
<style>.ar { font-family: var(--arabic); color: var(--teal); font-size: 1.2rem; margin: 0; }</style>
