---
import Thumb from './Thumb.astro';
import { subjectLabel, levelLabel, flattenLessons, courseUrl, dirFor, type Course } from '../lib/courses';
const { course } = Astro.props as { course: Course };
const d = course.data;
const lessons = flattenLessons(course);
---
<a class="course-card" href={courseUrl(course.id)}>
  <span class="card-thumb"><Thumb id={lessons.find((l) => l.youtube_id)?.youtube_id} label={subjectLabel(course)} /><span class="count">{lessons.length} videos</span></span>
  <span class="card-body">
    <h3 lang={d.language} dir={dirFor(d.language)}>{d.title}</h3>
    <span class="meta"><bdi>{d.source.name}</bdi> · {levelLabel(d.level)} {d.demo && <span class="badge">Demo</span>}</span>
  </span>
</a>
